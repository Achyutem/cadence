    <!--
      A quantity string, not a format string: "1 of 1 tasks complete" is wrong in English and
      more wrong in languages with richer plural rules. The count that governs the form is the
      total, which is what the second argument agrees with.
    -->
    <plurals name="today_progress_description">
        <item quantity="one">%1$d of %2$d task complete</item>
        <item quantity="other">%1$d of %2$d tasks complete</item>
    </plurals>

