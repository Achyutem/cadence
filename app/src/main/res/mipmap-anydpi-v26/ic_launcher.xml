<?xml version="1.0" encoding="utf-8"?>
<!--
  The `-v26` qualifier is required by the resource merger even though minSdk is well past 26: a bare
  `mipmap-anydpi` folder is not recognised and the resource fails to link. Lint's suggestion to
  drop it is wrong here, so the folder stays as-is.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
