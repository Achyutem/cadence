<?xml version="1.0" encoding="utf-8"?>
<!--
  The next thing due.

  targetCellWidth/Height are the Android 12+ way of sizing a widget and are what modern launchers
  actually honour; minWidth/minHeight remain as the fallback for older grids. resizeMode is set on
  every widget because a productivity widget the user cannot make taller is a widget that shows
  three items forever.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="80dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:description="@string/widget_next_description"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
